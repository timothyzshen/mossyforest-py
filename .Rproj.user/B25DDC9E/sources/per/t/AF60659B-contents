        (Eq.~\eqref{eq:dml}).
  \item For each pool $\mathcal{P}$ and each bootstrap $b=1,\dots,B$: subsample $\lfloor n/2\rfloor$
        rows, build the shadow matrix $\tilde{\mathbf{X}}$, fit a random forest on
        $[\mathbf{X}_{\mathcal{P}}\mid\tilde{\mathbf{X}}]$, compute $\tau_b$ (Eq.~\eqref{eq:shadow_thr}),
        and mark $j$ selected if $\Phi_j > \tau_b$.
  \item Compute $\widehat{\Pi}_j$ (Eq.~\eqref{eq:stability_freq}); keep $j$ if it meets the pool cutoff
        (\texttt{pi\_thr} for correlated pools, elbow/\texttt{pi\_thr\_indep} for the independent pool).
  \item Stable set $\mathcal{S}^\star \gets$ union of per-pool stable sets.
\end{enumerate}
\emph{Phase 3 --- final attribution.}
\begin{enumerate}\itemsep2pt \parskip0pt \setcounter{enumi}{7}
  \item Fit a random forest on $\mathbf{X}_{\cdot,\mathcal{S}^\star}$ with the original $\mathbf{y}$ and
        compute exact TreeSHAP $\mathbf{\Phi}$.
  \item \textbf{Return} $\mathcal{S}^\star$, importances $\Phi_j$, signed means $\bar{\phi}_j$, and the
        interaction matrix.
\end{enumerate}
\end{minipage}}
